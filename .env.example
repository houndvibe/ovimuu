# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# PostgreSQL connection string (required). Matches docker-compose.yml defaults.
DATABASE_URL=postgres://ovimuu:ovimuu@localhost:5432/ovimuu

# Your Telegram numeric user id — gets access to /stats (required)
ADMIN_TELEGRAM_ID=

# Yandex Cloud: folder id + service account API key (required from stage 1 step 5)
YC_FOLDER_ID=
YC_API_KEY=
# Optional model overrides (defaults: yandexgpt-5.1/latest, aliceai-llm-flash/latest)
YC_MODEL_PARSE=
YC_MODEL_INTENT=

# Public HTTPS URL of the app (required when NODE_ENV=production; webhook + Mini App)
PUBLIC_URL=

# development | production | test
NODE_ENV=development
